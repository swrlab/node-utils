{
	"name": "node-utils-workspace",
	"version": "",
	"private": true,
	"packageManager": "bun@1.3.9",
	"description": "SWR Audio Lab utilities collection.",
	"type": "module",
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/swrlab/node-utils.git"
	},
	"author": "SWR Audio Lab <lab@swr.de>",
	"workspaces": {
		"packages": [
			"packages/storage",
			"packages/utils-legacy",
			"packages/utils"
		],
		"catalogs": {
			"dev": {
				"@arethetypeswrong/cli": "^0.18.2",
				"@types/node": "^25.5.0",
				"@vitest/coverage-v8": "4.1.0",
				"bumpp": "^11.0.1",
				"knip": "^5.88.0",
				"tsdown": "^0.21.4",
				"typescript": "^5.9.3",
				"vitest": "^4.1.0"
			}
		}
	},
	"scripts": {
		"ard:coreId": "bun ./packages/utils/src/ard/coreId.ts",
		"attw": "attw --pack . --profile esm-only",
		"biome": "biome check",
		"build": "bun run --filter ./packages/utils build && bun run --filter ./packages/storage build && bun run --filter ./packages/utils-legacy build",
		"build:parallel": "bun run --filter './packages/{utils,storage,utils-legacy}' build",
		"check": "bun run --parallel lint format:check typecheck",
		"clear": "rm -rf ./node_modules ./packages/*/node_modules/",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"format:check:beta": "prettier --experimental-cli --config-path ./prettier.config.js --check .",
		"knip": "knip",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"release": "bumpp",
		"test": "bun run --filter './packages/{utils,storage,utils-legacy}' test",
		"test:bun": "bun run --filter './packages/utils' test:bun",
		"test:node": "bun run --filter '*' test:node",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {},
	"devDependencies": {
		"@arethetypeswrong/cli": "catalog:dev",
		"@biomejs/biome": "2.4.7",
		"@swrlab/style-guide": "^2.1.7",
		"@types/node": "catalog:dev",
		"biome": "^0.3.3",
		"eslint": "^10.0.3",
		"knip": "catalog:dev",
		"prettier": "^3.8.1",
		"typescript": "catalog:dev",
		"vitest": "catalog:dev"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^22.18.0 || >= 24.6",
			"onFail": "warn"
		},
		"packageManager": {
			"name": "bun",
			"onFail": "warn"
		}
	},
	"engines": {
		"node": "^22.18.0 || >= 24.6.0"
	}
}
