{
	"$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["packages/**/*.{js,mjs,ts}", "!**/dist/*", "!**/coverage/*"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"useEditorconfig": true,
		"bracketSpacing": true,
		"bracketSameLine": true,
		"expand": "auto"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noExplicitAny": "off"
			},
			"style": {
				"useImportType": "on",
				"useExportType": "on",
				"useNodejsImportProtocol": "on"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"lineEnding": "lf",
			"semicolons": "asNeeded",
			"lineWidth": 120,
			"trailingCommas": "es5",
			"arrowParentheses": "always",
			"attributePosition": "auto",
			"bracketSameLine": true,
			"bracketSpacing": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": {
					"level": "off",
					"options": {
						"identifierOrder": "natural",
						"groups": [
							{ "type": true },
							":URL:",
							":PACKAGE_WITH_PROTOCOL:",
							":PACKAGE:",
							":NODE:",
							":BUN:",
							":ALIAS:",
							":PATH:"
						]
					}
				}
			}
		}
	}
}
