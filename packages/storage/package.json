{
	"name": "@swrlab/storage",
	"version": "1.0.0-beta.4",
	"description": "SWR Audio Lab storage utilities for Node.js.",
	"license": "ISC",
	"author": "SWR Audio Lab <lab@swr.de>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/swrlab/node-utils.git",
		"directory": "packages/storage"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"attw": "bunx @arethetypeswrong/cli --pack . --profile esm-only",
		"build": "vp pack",
		"test": "bun run typecheck && bun run test:bun && bun run test:node",
		"test:bun": "bun test",
		"test:node": "node --test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@google-cloud/storage": "^7.19.0"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:"
	},
	"engines": {
		"node": "^22.18.0 || >= 24.6.0"
	},
	"packageManager": "bun@1.3.9"
}
