{
	"name": "@swrlab/utils-legacy",
	"version": "3.0.1-beta.3",
	"packageManager": "bun@1.3.9",
	"description": "Previous generation of SWR Audio Lab utilities for Node.js.",
	"type": "module",
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/swrlab/node-utils.git",
		"directory": "packages/utils-legacy"
	},
	"author": "SWR Audio Lab <lab@swr.de>",
	"files": [
		"dist"
	],
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			}
		},
		"./packages/*": {
			"require": {
				"types": "./dist/packages/*.d.cts",
				"default": "./dist/packages/*.cjs"
			},
			"import": {
				"types": "./dist/packages/*.d.mts",
				"default": "./dist/packages/*.mjs"
			}
		}
	},
	"publishConfig": {
		"access": "public",
		"name": "@swrlab/utils",
		"provenance": true,
		"tag": "legacy"
	},
	"scripts": {
		"build": "tsdown",
		"release": "bumpp",
		"test": "bun run test:bun",
		"test:bun": "bun test ./test/*test.ts",
		"test:mjs": "bun test ./test/*test.mjs",
		"test:dist": "bun test ./test/dist/*test.mjs",
		"test:dist:node": "node --test ./test/*test.mjs",
		"test:node": "node --test ./test/*.test.ts"
	},
	"dependencies": {
		"@google-cloud/storage": "^7.19.0",
		"luxon": "3.7.2",
		"node-crc": "https://github.com/swrlab/node-crc#v2.1.0",
		"undici": "7.24.4"
	},
	"devDependencies": {
		"@swrlab/storage": "workspace:*",
		"@swrlab/utils": "workspace:*",
		"@types/node": "^25.5.0",
		"bumpp": "^11.0.1",
		"tsdown": "^0.21.4",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": "^22.18.0 || >= 24.6.0"
	}
}
