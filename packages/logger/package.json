{
	"name": "@swrlab/logger",
	"version": "3.0.0-beta.3",
	"packageManager": "bun@1.2.22",
	"description": "SWR Audio Lab logging utilities for Node.js.",
	"type": "module",
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/swrlab/node-utils.git",
		"directory": "packages/logger"
	},
	"author": "SWR Audio Lab <lab@swr.de>",
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"attw": "bunx @arethetypeswrong/cli --pack . --profile esm-only",
		"build": "tsdown",
		"test": "bun run typecheck && bun run test:bun && bun run test:legacy",
		"test:bun": "bun test ./test/**test*.ts",
		"test:node": "node --test ./test/**.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"winston": "^3.17.0"
	},
	"devDependencies": {
		"@types/luxon": "^3.7.1",
		"@types/node": "^24.3.1",
		"consola": "^3.4.2",
		"luxon": "3.7.2",
		"tsdown": "^0.14.2",
		"typescript": "^5.9.2"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^22.18.0 || >= 24.6",
			"onFail": "warn"
		},
		"packageManager": {
			"name": "bun",
			"onFail": "warn"
		}
	},
	"engines": {
		"node": "^22.18.0 || >= 24.6.0"
	}
}
